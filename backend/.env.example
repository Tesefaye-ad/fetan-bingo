# ═══════════════════════════════════════════════════════
# Fetan Bingo — Environment Variables (EXAMPLE)
# ═══════════════════════════════════════════════════════
# ⚠️ ይህ ፋይል ለ Git ይጋራል — እውነተኛ ምስጢሮችን አትጻፍ!
# እውነተኛውን ዋጋ .env ፋይል ውስጥ ብቻ አስቀምጥ።
# ═══════════════════════════════════════════════════════

# ---- Server ----
PORT=5000
CLIENT_URL=https://fetan-bingo-rho.vercel.app
REACT_APP_API_URL=https://fetan-bingo-he4x.onrender.com
RENDER_EXTERNAL_URL=https://fetan-bingo-he4x.onrender.com

# ---- MongoDB ----
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fetan-bingo

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=<token-from-BotFather>
TELEGRAM_BOT_USERNAME=@fetanbingo1_bot
WINNERS_GROUP_CHAT_ID=<telegram-group-chat-id>

# ---- Auth ----
# ረጅም የዘፈቀደ ሕብረቁምፊ ተጠቀም (≥ 64 ፊደሎች)።
# ለማመንጨት: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<64-byte-hex-random-string>

# ---- Game defaults ----
# የካርቴላ መምረጫ ሰዓት (Play 10 / Play 20) — ለሁሉም ተጠቃሚ ቋሚ
SELECTION_TIMER_MS=50000
ENTRY_FEE=10

# ---- Telegram bot ----
BOT_WEBAPP_URL=https://your-frontend.vercel.app
BOT_BANNER_URL=
ADMIN_CHAT_ID=<admin-telegram-id>
SUPPORT_CONTACT=@FetanBingoSupport
DEPOSIT_TELEBIRR_PHONE=<telebirr-phone>
MIN_DEPOSIT=20
MIN_WITHDRAW=50
BONUS_CONVERSION_RATE=1
# ---- Play 50 / Play 100 ዕለታዊ መጀመሪያ (ኢትዮጵያ ሰዓት UTC+3, 24-ሰዓት) ----
# 12 → Play 50 በ 12:00:00, Play 100 በ 12:05:00 (ቀን 6:00 AM ባህላዊ ለማድረግ 6 ተጠቀም)
WEEKLY_START_HOUR=12
